# tunnel-manager (DOP-170) — see docs/decisions/0002-backend-client-api-contract.md
TUNNEL_MANAGER_ADDR=0.0.0.0:8080
RUST_LOG=info,tower_http=debug

# Sui (required from Phase 1 onward; optional in Phase 0)
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# Network for Enoki sponsorship (testnet/mainnet/devnet). MUST match ENOKI_API_KEY's network.
# Keep testnet: the settler fallback's chain digest is testnet-pinned (ADR-0014).
SUI_NETWORK=testnet
TUNNEL_PACKAGE_ID=0x0b89fe86e42cdbfd1e614757a83d014b455d12923d0dded58842ab18f8a5a22b
# Stake coin type. MTPS is the free stake token games stake; the sponsor pins tunnel calls + the
# close payout to this type. Gas is still paid in SUI by the settler. Set 0x2::sui::SUI to stake SUI.
TUNNEL_COIN_TYPE=0xf62966a08ab983e10224012bace10d2189ee9af4d67f0640bacb1f6d561ec83b::mtps::MTPS
# base64 ed25519 secret of the gas/settler account. MUST hold SUI (the SIP-58 gas source); it
# needs NO MTPS (the faucet mints that). `sui keytool export … | sui keytool convert` -> base64.
# With the faucet (below), this is also the MTPS mint key — it must own the AdminCap.
SUI_SETTLER_KEY=

# MTPS faucet (ADR-0023). The backend signs `admin_mint` with SUI_SETTLER_KEY, which must own the
# AdminCap (= the deploy key — see docs/runbooks/mtps-deploy.md). Unset MTPS_ADMIN_CAP_ID disables
# both faucet routes (503). Amounts are whole tokens (0 decimals).
MTPS_ADMIN_CAP_ID=0x097e56a11cee007f947a719ed82811f42f1a903d989e79a21ae5a3dc90a83aac
# Public faucet: whole-token MTPS per pull, rate-limited to MAX pulls per WINDOW per address.
FAUCET_USER_AMOUNT=10000
FAUCET_COOLDOWN_SECS=1800
FAUCET_MAX_PER_WINDOW=5
# Internal faucet: default mint amount (caps at the contract's MAX_MINT_PER_CALL = 10,000,000,000).
FAUCET_INTERNAL_AMOUNT=1000000
# Shared bearer secret gating POST /v1/faucet/internal. Unset = internal route disabled (503).
FAUCET_ADMIN_TOKEN=

# Enoki sponsored transactions (ADR-0014): the PRIMARY gas sponsor; the settler above is the
# fallback. The PRIVATE key (`enoki_private_…`) from the Enoki portal — server-side ONLY, distinct
# from the frontend's PUBLIC VITE_ENOKI_API_KEY (zkLogin). Leave blank here and set the real key in
# the gitignored .env. Unset = settler-only. The Enoki app must allowlist the tunnel/coin/example
# packages for the configured SUI_NETWORK, else every sponsor falls back to the settler.
ENOKI_API_KEY=

# Public sponsor stop-loss (valid /v1/sponsor grants, before Enoki or settler gas is requested).
# These caps do not throttle the controlled arena fleet; tune them for public spend protection.
SPONSOR_SENDER_WINDOW_SECS=60
SPONSOR_SENDER_MAX_PER_WINDOW=1000
SPONSOR_GLOBAL_WINDOW_SECS=86400
SPONSOR_GLOBAL_MAX_PER_WINDOW=100000

# Walrus (required from Phase 2 onward)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# S3 transcript archival (ADR-0023). Archives the settle body to S3 alongside Walrus.
# Unset => archival disabled (local dev). In ECS this comes from Pulumi as a plaintext env.
S3_TRANSCRIPTS_BUCKET=
# Optional key prefix, e.g. "prod/". Default empty.
S3_TRANSCRIPTS_PREFIX=
# AWS region for the S3 client (default chain also reads this). ECS injects it.
AWS_REGION=us-east-1

# Ollama LLM proxy (chat-v2)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Slim example-app packages — sponsored when set (agent allowance, streaming payment).
AGENT_ALLOWANCE_PACKAGE_ID=0x36d982ffdcf89c709829650bd6b07128f505f41d8953f48658746291d5bfb679
STREAMING_PAYMENT_PACKAGE_ID=0xd879bc156d7494d49b837222a8ebb348694a0685267129a76bdc1789c63c1edb

# Redis (local dev). Both must be set together (cache + pubsub) or startup fails loud.
REDIS_CACHE_URL=redis://127.0.0.1:6379
REDIS_PUBSUB_URL=redis://127.0.0.1:6379

# Co-located arena fleet (ADR-0027/0028): in-process bots that play arena matches over the relay
# bus. Inert by default (count 0); set COUNT>0 + a comma-split game list to spawn bots. Each bot
# pre-creates the tunnel + funds seat B at allocate (the real on-chain open needs the wallet pool).
# Games must have a wired Rust↔TS parity (today: quantum_poker); see fleet_core::play_match.
# Sized to the funded wallet-pool prefix (~5k members); each concurrent match consumes one funded
# seat-B wallet, so COUNT x served-games should stay <= WALLET_POOL_FUNDED_COUNT (fund more to raise).
FLEET_COLOCATED_COUNT=5000
FLEET_COLOCATED_GAMES=quantum_poker

# Funded seat-B wallet pool (PR #124) — replaces the single FLEET_BOT_KEY. When WALLET_POOL_ID is set,
# each on-demand bot's seat-B address comes from a checked-out pool member, and the opener self-signs
# create + deposit_party_b AS that member (funding spreads across the pool, no single-key bottleneck).
# Unset => placeholder identities + Noop opener (the off-chain dev path). The pool blob is opened once
# at startup from S3 (CacheMode::None — a 1M-member pool is not pre-warmed); SUI_RPC_URL + SUI_NETWORK
# above are reused. Only a funded prefix is usable, so set WALLET_POOL_FUNDED_COUNT to the funded
# member count (round-robin stays inside it). S3 bucket + AWS creds come from the environment
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION / WALLET_POOL_S3_BUCKET).
WALLET_POOL_ID=
WALLET_POOL_ACCESS_VALUE=
WALLET_POOL_S3_BUCKET=
WALLET_POOL_FUNDED_COUNT=
